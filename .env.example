# Copy to .env (setup.ps1 does this for you). Never commit .env.

# External AI model (free key: https://aistudio.google.com -> Get API key). Optional:
# without it the gateway still runs all security checks, and uses the local model if Ollama is running.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Signing key for login tokens (base64, 32+ bytes). setup.ps1 generates one.
JWT_SECRET=

# Database: leave DB_PROFILE=local for a zero-install file database (H2).
# Set DB_PROFILE=mysql to use MySQL - on this machine (localhost) or on a teammate's device (its IP).
# See docs/02_REMOTE_SETUP.md and scripts/mysql-setup.sql.
DB_PROFILE=local
DB_URL=jdbc:mysql://localhost:3306/cybercup_db?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Kolkata
DB_USERNAME=cybercup
DB_PASSWORD=

# Optional shared secret between backend and security engine (set the SAME value on both machines
# when they are different devices)
ENGINE_API_KEY=

# ---- Running on several devices (docs/02_REMOTE_SETUP.md) ----
# Which services run on THIS machine
START_ENGINE=true
START_BACKEND=true
START_FRONTEND=true
# true = other devices on the network may reach the services started here
SHARE_ON_NETWORK=false
# Where the frontend finds the backend, if the backend runs on another device (e.g. http://192.168.1.20:8080)
BACKEND_URL=
# Where the backend finds the security engine, if it runs on another device (e.g. http://192.168.1.15:8000)
AI_ENGINE_BASE_URL=
# Extra frontend addresses allowed to call this backend, comma separated (e.g. http://192.168.1.15:5173)
EXTRA_CORS_ORIGINS=

# Optional local model (https://ollama.com, then: ollama pull llama3.2:3b)
OLLAMA_MODEL=llama3.2:3b
