# Copy to .env and adjust. Never commit .env.

# Secret for hashing detected values in audit logs (use a long random string).
ENGINE_HMAC_KEY=change-me-to-a-long-random-string

# Required: Spring Boot must send this value in the X-Engine-Key header. Without a key the engine
# refuses requests (ENGINE_ALLOW_NO_KEY=true turns that off for local experiments only).
ENGINE_API_KEY=

# Presidio NER for person names (true/false)
USE_PRESIDIO=true

# Local Llama via Ollama (grey-zone analysis only)
USE_LLM=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_S=15

# ML injection layers (semantic similarity + classifier); set false for a light install
USE_ML_INJECTION=true
USE_CLASSIFIER=true

# Injection score thresholds
INJECTION_BLOCK=0.70
INJECTION_GREY_LOW=0.30

# More distinct personal-data values than this in one prompt = BLOCK (bulk export)
BULK_PII_LIMIT=10

# Seconds to keep masked values for re-hydrating the AI response
VAULT_TTL_S=1800

# OCR for pictures inside uploaded PDFs, Word files and images (true/false)
USE_OCR=true
OCR_THREADS=4
